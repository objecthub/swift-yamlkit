{"abstract":[{"text":"Decode and encode Swift types, work with untyped YAML documents, and control the","type":"text"},{"text":" ","type":"text"},{"text":"generated output.","type":"text"}],"hierarchy":{"paths":[["doc://org.objecthub.YamlKit/documentation/YamlKit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://org.objecthub.YamlKit/documentation/YamlKit/GettingStarted"},"kind":"article","metadata":{"modules":[{"name":"YamlKit"}],"role":"article","roleHeading":"Article","title":"Getting Started with YamlKit"},"primaryContentSections":[{"content":[{"anchor":"Decoding","level":2,"text":"Decoding","type":"heading"},{"inlineContent":[{"text":"Create a ","type":"text"},{"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLDecoder","isActive":true,"type":"reference"},{"text":" and decode any ","type":"text"},{"code":"Decodable","type":"codeVoice"},{"text":" type from a ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The character encoding of ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":" (UTF-8, UTF-16, or UTF-32) is detected automatically.","type":"text"}],"type":"paragraph"},{"code":["struct Config: Decodable {","  var name: String","  var retries: Int","  var timeout: Double?","  var hosts: [String]","}","","let config = try YAMLDecoder().decode(Config.self, from: \"\"\"","  name: backend","  retries: 3","  hosts:","    - alpha.example.com","    - beta.example.com","  \"\"\")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Plain scalars are interpreted using the YAML 1.2 core schema: ","type":"text"},{"code":"3","type":"codeVoice"},{"text":" is an integer, ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" ","type":"text"},{"text":"a boolean, ","type":"text"},{"code":"~","type":"codeVoice"},{"text":", ","type":"text"},{"code":"null","type":"codeVoice"},{"text":", or an empty value is null. Quoted scalars are always strings.","type":"text"},{"text":" ","type":"text"},{"text":"A ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" property accepts any non-null scalar, so ","type":"text"},{"code":"version: 1.10","type":"codeVoice"},{"text":" decodes as ","type":"text"},{"code":"\"1.10\"","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Streams with several documents can be decoded with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLDecoder/decodeAll(_:from:)-9z3rw","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let manifests = try YAMLDecoder().decodeAll(Manifest.self, from: text)"],"syntax":"swift","type":"codeListing"},{"anchor":"Decoding-Strategies","level":3,"text":"Decoding Strategies","type":"heading"},{"inlineContent":[{"text":"Like ","type":"text"},{"code":"JSONDecoder","type":"codeVoice"},{"text":", the decoder supports strategies for dates, binary data, and keys:","type":"text"}],"type":"paragraph"},{"code":["let decoder = YAMLDecoder()","decoder.keyDecodingStrategy = .convertFromSnakeCase   // max_retries → maxRetries","decoder.dateDecodingStrategy = .timestamp             // 2001-12-14t21:59:43.10-05:00","decoder.dataDecodingStrategy = .base64                // !!binary R0lGODlhDAAMAIQAAP"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"YAML 1.1 merge keys (","type":"text"},{"code":"<<: *defaults","type":"codeVoice"},{"text":"), which are popular in configuration files, can be","type":"text"},{"text":" ","type":"text"},{"text":"enabled via the parse options:","type":"text"}],"type":"paragraph"},{"code":["decoder.parseOptions.resolvesMergeKeys = true"],"syntax":"swift","type":"codeListing"},{"anchor":"Errors","level":3,"text":"Errors","type":"heading"},{"inlineContent":[{"text":"Decoding errors are reported as ","type":"text"},{"code":"DecodingError","type":"codeVoice"},{"text":" values whose context contains the coding","type":"text"},{"text":" ","type":"text"},{"text":"path and, where available, the line and column of the offending node. Syntax errors are","type":"text"},{"text":" ","type":"text"},{"text":"reported as ","type":"text"},{"code":"DecodingError.dataCorrupted","type":"codeVoice"},{"text":" with an underlying ","type":"text"},{"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLError","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Encoding","level":2,"text":"Encoding","type":"heading"},{"inlineContent":[{"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLEncoder","isActive":true,"type":"reference"},{"text":" produces block-style YAML that preserves the order in which properties","type":"text"},{"text":" ","type":"text"},{"text":"are encoded:","type":"text"}],"type":"paragraph"},{"code":["let encoder = YAMLEncoder()","encoder.outputFormatting = [.sortedKeys]","encoder.keyEncodingStrategy = .convertToSnakeCase","let text = try encoder.encodeToString(config)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Strings are quoted only where necessary: values such as ","type":"text"},{"code":"\"true\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"null\"","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"\"1.0\"","type":"codeVoice"},{"text":" ","type":"text"},{"text":"are quoted so that they are read back as strings, and multi-line strings are written as","type":"text"},{"text":" ","type":"text"},{"text":"literal block scalars.","type":"text"}],"type":"paragraph"},{"anchor":"Working-with-Nodes","level":2,"text":"Working with Nodes","type":"heading"},{"inlineContent":[{"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAML/parse(_:options:)-6frv3","isActive":true,"type":"reference"},{"text":" composes a document into a ","type":"text"},{"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLNode","isActive":true,"type":"reference"},{"text":" tree,","type":"text"},{"text":" ","type":"text"},{"text":"which can be inspected, modified, and serialized again:","type":"text"}],"type":"paragraph"},{"code":["let root = try YAML.parse(\"servers: [alpha, beta]\")","print(root?[\"servers\"]?[1]?.string ?? \"\")   // beta","","let document: YAMLNode = [\"name\": \"YamlKit\", \"tags\": [\"swift\", \"yaml\"]]","print(try YAML.serialize(document))"],"syntax":"swift","type":"codeListing"},{"anchor":"Working-with-Events","level":2,"text":"Working with Events","type":"heading"},{"inlineContent":[{"text":"For streaming use cases, ","type":"text"},{"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLParser","isActive":true,"type":"reference"},{"text":" produces ","type":"text"},{"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLEvent","isActive":true,"type":"reference"},{"text":" values one at a time,","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLEmitter","isActive":true,"type":"reference"},{"text":" turns events back into text:","type":"text"}],"type":"paragraph"},{"code":["var parser = try YAMLParser(string: text)","while let event = try parser.next() {","  print(event.kind)","}"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"references":{"doc://org.objecthub.YamlKit/documentation/YamlKit":{"abstract":[{"text":"Parse and generate YAML 1.2 and convert between YAML and Swift types with ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit","kind":"symbol","role":"collection","title":"YamlKit","type":"topic","url":"/documentation/yamlkit"},"doc://org.objecthub.YamlKit/documentation/YamlKit/YAML/parse(_:options:)-6frv3":{"abstract":[{"text":"Parses a stream consisting of at most one document and re