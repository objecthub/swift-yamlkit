d":"identifier","text":"YAMLParser"}],"role":"symbol","title":"YAMLParser","type":"topic","url":"/documentation/yamlkit/yamlparser"},"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLSchema":{"abstract":[{"text":"A schema determines how untagged plain scalars are resolved to tags","type":"text"},{"text":" ","type":"text"},{"text":"(YAML 1.2.2, chapter 10).","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"YAMLSchema"}],"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLSchema","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"YAMLSchema"}],"role":"symbol","title":"YAMLSchema","type":"topic","url":"/documentation/yamlkit/yamlschema"},"https://github.com/yaml/yaml-test-suite":{"identifier":"https://github.com/yaml/yaml-test-suite","title":"YAML test suite","titleInlineContent":[{"text":"YAML test suite","type":"text"}],"type":"link","url":"https://github.com/yaml/yaml-test-suite"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["/documentation/yamlkit/architecture"],"traits":[{"interfaceLanguage":"swift"}]}]}