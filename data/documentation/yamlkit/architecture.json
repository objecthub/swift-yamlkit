{"abstract":[{"text":"How YamlKit implements the YAML 1.2.2 processing model and how it can be extended.","type":"text"}],"hierarchy":{"paths":[["doc://org.objecthub.YamlKit/documentation/YamlKit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://org.objecthub.YamlKit/documentation/YamlKit/Architecture"},"kind":"article","metadata":{"modules":[{"name":"YamlKit"}],"role":"article","roleHeading":"Article","title":"Architecture"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"The YAML specification describes YAML processing as a series of transformations between","type":"text"},{"text":" ","type":"text"},{"text":"three representations (chapter 3). YamlKit implements each of them as a separate,","type":"text"},{"text":" ","type":"text"},{"text":"publicly accessible layer:","type":"text"}],"type":"paragraph"},{"code":["               parse            compose             decode"," YAML text ──────────▶ events ──────────▶ nodes ──────────▶ Swift values","           ◀────────── events ◀────────── nodes ◀────────── Swift values","               emit           serialize             encode"],"syntax":null,"type":"codeListing"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Layer","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Types","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Responsibility","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Reader","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Reader","type":"codeVoice"},{"text":" (internal)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Encoding detection, line break normalization","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Scanner","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Scanner","type":"codeVoice"},{"text":" (internal)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Tokens, indentation, scalar folding and escaping","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Parser","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLParser","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLEvent","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Grammar of documents, nodes, and collections","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Composer","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAML","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLNode","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLSchema","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Tag resolution, aliases, key uniqueness, merge keys","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Serializer","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAML","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Implicit tags, quoting, anchors and aliases","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Emitter","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLEmitter","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Presentation styles, indentation, line folding","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Codable","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLDecoder","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLEncoder","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Mapping between nodes and ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" types","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"anchor":"Scanner-and-Parser","level":3,"text":"Scanner and Parser","type":"heading"},{"inlineContent":[{"text":"The scanner follows the proven design of libyaml: it converts indentation into explicit","type":"text"},{"text":" ","type":"text"},{"text":"block start and end tokens and inserts the tokens of implicit keys retroactively once","type":"text"},{"text":" ","type":"text"},{"text":"the value indicator ","type":"text"},{"code":":","type":"codeVoice"},{"text":" has been found. On top of that design, it implements the rules","type":"text"},{"text":" ","type":"text"},{"text":"that YAML 1.2 tightened compared to YAML 1.1, e.g. restrictions on tabs, the","type":"text"},{"text":" ","type":"text"},{"text":"requirement that block collections start on a new line, multi-line keys in flow","type":"text"},{"text":" ","type":"text"},{"text":"mappings, JSON-like keys followed by adjacent values, and the indentation of flow","type":"text"},{"text":" ","type":"text"},{"text":"content. Every rule is annotated with the production number of the specification.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The parser is a pull-based LL(1) state machine. It never recurses, so the nesting depth","type":"text"},{"text":" ","type":"text"},{"text":"of documents is only limited by the configurable ","type":"text"},{"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAML/ParseOptions/maximumDepth","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Composer-and-Schemas","level":3,"text":"Composer and Schemas","type":"heading"},{"inlineContent":[{"text":"The composer resolves the tags of untagged nodes using a ","type":"text"},{"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLSchema","isActive":true,"type":"reference"},{"text":". The three","type":"text"},{"text":" ","type":"text"},{"text":"schemas of the specification are provided; custom schemas, e.g. to interpret the","type":"text"},{"text":" ","type":"text"},{"text":"YAML 1.1 booleans ","type":"text"},{"code":"yes","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"no","type":"codeVoice"},{"text":", can be implemented by conforming to the protocol.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Aliases are replaced by the nodes they refer to. Because ","type":"text"},{"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLNode","isActive":true,"type":"reference"},{"text":" is a value type,","type":"text"},{"text":" ","type":"text"},{"text":"the copies share their storage. To protect against maliciously crafted documents","type":"text"},{"text":" ","type":"text"},{"text":"(“billion laughs”), the total number of nodes copied by aliases is limited by","type":"text"},{"text":" ","type":"text"},{"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAML/ParseOptions/maximumAliasExpansion","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Serializer-and-Emitter","level":3,"text":"Serializer and Emitter","type":"heading"},{"inlineContent":[{"text":"The serializer decides for every scalar whether its tag can be left implicit: a string","type":"text"},{"text":" ","type":"text"},{"text":"such as ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" must be quoted, while an integer tagged ","type":"text"},{"code":"!!int","type":"codeVoice"},{"text":" can be written in plain","type":"text"},{"text":" ","type":"text"},{"text":"style. The emitter chooses the presentation style of every scalar, honoring the","type":"text"},{"text":" ","type":"text"},{"text":"requested style if the content permits it. It falls back to single-quoted and finally","type":"text"},{"text":" ","type":"text"},{"text":"double-quoted style where necessary.","type":"text"}],"type":"paragraph"},{"anchor":"Conformance-Testing","level":2,"text":"Conformance Testing","type":"heading"},{"inlineContent":[{"text":"The package vendors a snapshot of the ","type":"text"},{"identifier":"https://github.com/yaml/yaml-test-suite","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"Tests/YamlKitTests/Resources/yaml-test-suite","type":"codeVoice"},{"text":"; refresh it with","type":"text"},{"text":" ","type":"text"},{"code":"Scripts/update-yaml-test-suite.sh","type":"codeVoice"},{"text":"). For every test case, the unit tests verify that","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"invalid documents are rejected and the events of valid documents match ","type":"text"},{"code":"test.event","type":"codeVoice"},{"text":",","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"composed nodes match the expected JSON data in ","type":"text"},{"code":"in.json","type":"codeVoice"},{"text":",","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"emitting the parsed events and parsing the result again yields equivalent events, and","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"serializing the composed nodes and parsing the result again yields equal nodes.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"In addition, randomized round-trip tests encode values containing all kinds of special","type":"text"},{"text":" ","type":"text"},{"text":"characters and verify that they are decoded unchanged.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://org.objecthub.YamlKit/documentation/YamlKit":{"abstract":[{"text":"Parse and generate YAML 1.2 and convert between YAML and Swift types with ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit","kind":"symbol","role":"collection","title":"YamlKit","type":"topic","url":"/documentation/yamlkit"},"doc://org.objecthub.YamlKit/documentation/YamlKit/YAML":{"abstract":[{"text":"Entry points for working with YAML at the level of events and nodes.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"YAML"}],"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAML","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"YAML"}],"role":"symbol","title":"YAML","type":"topic","url":"/documentation/yamlkit/yaml"},"doc://org.objecthub.YamlKit/documentation/YamlKit/YAML/ParseOptions/maximumAliasExpansion":{"abstract":[{"text":"The maximum number of nodes that may be copied by resolving aliases","type":"text"},{"text":" ","type":"text"},{"text":"in a single document. This protects against “billion laughs” attacks.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumAliasExpansion"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAML/ParseOptions/maximumAliasExpansion","kind":"symbol","role":"symbol","title":"maximumAliasExpansion","type":"topic","url":"/documentation/yamlkit/yaml/parseoptions/maximumaliasexpansion"},"doc://org.objecthub.YamlKit/documentation/YamlKit/YAML/ParseOptions/maximumDepth":{"abstract":[{"text":"The maximum nesting depth of collections. Decoding values with","type":"text"},{"text":" ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" is recursive; very deeply nested documents may require a","type":"text"},{"text":" ","type":"text"},{"text":"thread with a larger stack than the default 512 KiB of secondary","type":"text"},{"text":" ","type":"text"},{"text":"threads.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumDepth"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAML/ParseOptions/maximumDepth","kind":"symbol","role":"symbol","title":"maximumDepth","type":"topic","url":"/documentation/yamlkit/yaml/parseoptions/maximumdepth"},"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLDecoder":{"abstract":[{"text":"An object that decodes instances of a data type from YAML documents.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"YAMLDecoder"}],"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLDecoder","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"YAMLDecoder"}],"role":"symbol","title":"YAMLDecoder","type":"topic","url":"/documentation/yamlkit/yamldecoder"},"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLEmitter":{"abstract":[{"text":"Turns a stream of ","type":"text"},{"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLEvent","isActive":true,"type":"reference"},{"text":" values into YAML text","type":"text"},{"text":" ","type":"text"},{"text":"(YAML 1.2.2, section 3.1.3 “Present”).","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"YAMLEmitter"}],"identifier":"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLEmitter","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"YAMLEmitter"}],"role":"symbol","title":"YAMLEmitter","type":"topic","url":"/documentation/yamlkit/yamlemitter"},"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLEncoder":{"abstract":[{"text":"An object that encodes instances of a